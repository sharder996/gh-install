#!/usr/bin/env bash
# gh-install - install the Multipass package built by CI for a given PR.
#
# This is a GitHub CLI extension. gh executes script extensions with a POSIX
# shell; on Windows that is the sh.exe bundled with Git for Windows, so this
# single script works on macOS and Windows. (Linux is not supported: snap
# packages are already distributed via the snap store.)

set -euo pipefail

REPO="canonical/multipass"
RUN_ID=""
DOWNLOAD_ONLY=0
EDGE=0
PR=""

# Downloaded packages are cached here so repeated installs don't re-download.
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/gh-install/packages"

# Cached packages older than this many days are pruned on each run.
# -1 = never prune, 0 = don't cache at all.
CACHE_DAYS="${GH_INSTALL_CACHE_DAYS:-30}"

usage() {
    cat <<'EOF'
gh install - install the Multipass package built by CI for a pull request.

USAGE
    gh install [pr-number | --edge] [flags]

    With no arguments (or --edge), installs the package from the latest
    successful nightly build of the platform workflow.

FLAGS
    --edge                Install the latest nightly build (default when no PR is given)
    --run <run-id>        Use a specific workflow run instead of resolving the PR head
    --download            Download the package only; do not install it
    -h, --help            Show this help

EXAMPLES
    gh install                           # install the latest nightly build
    gh install --edge                    # same thing, spelled out
    gh install 5135                      # install the package from PR 5135
    gh install 5135 --download           # download the package only
    gh install --run 123456789           # install from a specific CI run

CACHE
    Packages are cached in ~/.cache/gh-install/packages (or
    \$XDG_CACHE_HOME/gh-install/packages) and reused when the same artifact
    is requested again (artifacts are immutable after upload). Cached
    packages older than 30 days are pruned on each run. Tune with
    \$GH_INSTALL_CACHE_DAYS: -1 never prunes, 0 disables caching.

NOTES
    - Artifacts expire after a retention period; if no artifact is found,
      re-run CI on the PR to produce a fresh one.
    - On Windows, run this from a Git Bash / gh terminal that can elevate
      (msiexec will prompt via UAC if needed).
EOF
}

die() {
    echo "error: $*" >&2
    exit 1
}

info() {
    echo "==> $*"
}

# --------------------------------------------------------------------------
# Parse arguments
# --------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --edge)
            EDGE=1
            shift
            ;;
        --run)
            RUN_ID="${2:?--run requires a value}"
            shift 2
            ;;
        --download)
            DOWNLOAD_ONLY=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            die "unknown flag: $1 (see --help)"
            ;;
        *)
            [[ -z "$PR" ]] || die "unexpected extra argument: $1"
            PR="$1"
            shift
            ;;
    esac
done

[[ -n "$PR" || -n "$RUN_ID" || "$EDGE" -eq 1 ]] || EDGE=1
[[ -z "$PR" || "$EDGE" -eq 0 ]] || die "a PR number and --edge are mutually exclusive"

# --------------------------------------------------------------------------
# Preconditions
# --------------------------------------------------------------------------
command -v gh >/dev/null 2>&1 || die "gh (GitHub CLI) is not installed"
gh auth status >/dev/null 2>&1 || die "gh is not authenticated; run 'gh auth login'"

# --------------------------------------------------------------------------
# Detect platform -> workflow + artifact pattern
#
# PR builds: the platform workflows are invoked via workflow_call from the
# "Dynamic CI" workflow, so the run to download from is the Dynamic CI run
# for the PR's head commit. Nightly builds (--edge): the same platform
# workflows run standalone on a schedule.
# --------------------------------------------------------------------------
UNAME="$(uname -s)"
case "$UNAME" in
    Darwin)
        EDGE_WORKFLOW="macos.yml"
        ARTIFACT_REGEX='\.pkg$'
        ;;
    MINGW*|MSYS*|CYGWIN*|Windows_NT)
        EDGE_WORKFLOW="windows.yml"
        ARTIFACT_REGEX='\.(msi|exe)$'
        ;;
    Linux)
        die "Linux is not supported: snap packages are distributed via the snap store
       (e.g. 'sudo snap install multipass --edge')."
        ;;
    *)
        die "unsupported OS: $UNAME"
        ;;
esac

info "Platform: $UNAME"

# --------------------------------------------------------------------------
# Resolve the workflow run
# --------------------------------------------------------------------------
if [[ -z "$RUN_ID" && "$EDGE" -eq 1 ]]; then
    info "Finding latest successful nightly $EDGE_WORKFLOW run in $REPO"
    RUN_ID="$(gh run list --repo "$REPO" --workflow "$EDGE_WORKFLOW" --event schedule \
        --json databaseId,conclusion \
        --jq '[.[] | select(.conclusion == "success")][0].databaseId // empty')"

    [[ -n "$RUN_ID" ]] || die "no successful nightly $EDGE_WORKFLOW run found in $REPO"
elif [[ -z "$RUN_ID" ]]; then
    info "Resolving head commit of PR #$PR in $REPO"
    SHA="$(gh pr view "$PR" --repo "$REPO" --json headRefOid --jq .headRefOid)" \
        || die "could not look up PR #$PR in $REPO"
    info "PR head: $SHA"

    RUN_ID="$(gh run list --repo "$REPO" --commit "$SHA" --workflow "Dynamic CI" \
        --json databaseId,conclusion \
        --jq '[.[] | select(.conclusion == "success")][0].databaseId // empty')"

    [[ -n "$RUN_ID" ]] || die "no successful 'Dynamic CI' run found for $SHA.
       CI may still be running, awaiting approval, or the artifacts may have
       expired. Re-run/approve CI on the PR, or pass --run <id> to use a
       specific run."
fi

info "Using workflow run: $RUN_ID"

# --------------------------------------------------------------------------
# Pick the package artifact
# --------------------------------------------------------------------------
ALL_ARTIFACTS="$(gh api "repos/$REPO/actions/runs/$RUN_ID/artifacts" \
    --jq ".artifacts[] | select(.expired == false) | .name")"

# On macOS, always use the combined package (multipass-*.mac-Darwin.pkg),
# not the per-runner arch-specific ones (macos-*-multipass-*.pkg).
ARTIFACT_NAME="$(echo "$ALL_ARTIFACTS" | grep -E "$ARTIFACT_REGEX" | head -n 1 || true)"

[[ -n "$ARTIFACT_NAME" ]] || die "no (unexpired) package artifact matching '$ARTIFACT_REGEX'
       found in run $RUN_ID. Re-run CI on the PR to produce a fresh package."

info "Found artifact: $ARTIFACT_NAME"

# --------------------------------------------------------------------------
# Download (with caching)
#
# CACHE_DAYS=0 disables caching: the package goes to a temp dir that is
# removed on exit, and the cache is left untouched. CACHE_DAYS=-1 keeps the
# cache but never prunes it.
# --------------------------------------------------------------------------
if [[ "$CACHE_DAYS" == "0" ]]; then
    PKG_DIR="$(mktemp -d 2>/dev/null || mktemp -d -t gh-install)"
    trap 'rm -rf "$PKG_DIR"' EXIT
else
    PKG_DIR="$CACHE_DIR"
    mkdir -p "$PKG_DIR"

    # Prune cached packages older than $CACHE_DAYS days (they mirror CI
    # artifacts, which expire server-side anyway).
    if [[ "$CACHE_DAYS" != "-1" ]]; then
        PRUNED="$(find "$PKG_DIR" -type f -mtime "+$CACHE_DAYS" -print -delete | wc -l | tr -d ' ')"
        [[ "$PRUNED" == "0" ]] || info "Pruned $PRUNED cached package(s) older than $CACHE_DAYS days"
    fi
fi
PKG_FILE="$PKG_DIR/$ARTIFACT_NAME"

# Last-updated time of the artifact, per the API. Artifacts are immutable
# after upload, so a cached file whose mtime is at or after updated_at is
# valid. (The API's size_in_bytes and digest both describe the artifact's
# zip blob, not the extracted package, so they can't validate the file.)
EXPECTED_UPDATED="$(gh api "repos/$REPO/actions/runs/$RUN_ID/artifacts" \
    --jq ".artifacts[] | select(.name == \"$ARTIFACT_NAME\" and .expired == false) | .updated_at" \
    | head -n 1)"

file_mtime() {
    # Portable mtime (epoch seconds).
    if stat -f %m "$1" >/dev/null 2>&1; then stat -f %m "$1"; else stat -c %Y "$1"; fi
}

epoch_of() {
    # ISO 8601 (e.g. 2026-08-19T18:13:54Z) -> epoch seconds.
    if date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$1" +%s >/dev/null 2>&1; then
        date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$1" +%s
    else
        date -u -d "$1" +%s
    fi
}

if [[ -f "$PKG_FILE" ]]; then
    if [[ "$(file_mtime "$PKG_FILE")" -ge "$(epoch_of "$EXPECTED_UPDATED")" ]]; then
        info "Using cached package: $PKG_FILE"
    else
        info "Cached package is stale; re-downloading"
        rm -f "$PKG_FILE"
    fi
fi

if [[ ! -f "$PKG_FILE" ]]; then
    info "Downloading to: $PKG_DIR"
    gh run download "$RUN_ID" --repo "$REPO" --name "$ARTIFACT_NAME" --dir "$PKG_DIR"
    [[ -f "$PKG_FILE" ]] || die "download produced no $ARTIFACT_NAME in $PKG_DIR"
fi

if [[ "$DOWNLOAD_ONLY" -eq 1 ]]; then
    info "Package ready: $PKG_FILE"
    if [[ "$CACHE_DAYS" == "0" ]]; then
        info "Note: caching disabled (GH_INSTALL_CACHE_DAYS=0); this file is deleted on exit."
    fi
    exit 0
fi

# --------------------------------------------------------------------------
# Install
# --------------------------------------------------------------------------
case "$PKG_FILE" in
    *.pkg)
        info "Installing with macOS installer (sudo may prompt for a password)"
        sudo installer -pkg "$PKG_FILE" -target /
        ;;
    *.msi)
        # Convert the Git Bash path to a Windows path for msiexec.
        WIN_PATH="$(cygpath -w "$PKG_FILE" 2>/dev/null || echo "$PKG_FILE")"
        info "Installing $WIN_PATH with msiexec"
        msiexec //i "$WIN_PATH" //passive //norestart
        ;;
    *.exe)
        WIN_PATH="$(cygpath -w "$PKG_FILE" 2>/dev/null || echo "$PKG_FILE")"
        info "Running installer $WIN_PATH"
        "$PKG_FILE"
        ;;
    *)
        die "don't know how to install: $PKG_FILE"
        ;;
esac

info "Done. Multipass from PR #$PR (run $RUN_ID) installed."
