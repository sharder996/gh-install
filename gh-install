#!/usr/bin/env bash
# gh-install - install the Multipass package built by CI for a given PR.
#
# This is a GitHub CLI extension. gh executes script extensions with a POSIX
# shell; on Windows that is the sh.exe bundled with Git for Windows, so this
# single script works on macOS and Windows (and Linux, for snaps).

set -euo pipefail

REPO="canonical/multipass"
RUN_ID=""
DOWNLOAD_ONLY=0
PR=""

# Downloaded packages are cached here so repeated installs don't re-download.
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/gh-install/packages"

usage() {
    cat <<'EOF'
gh install - install the Multipass package built by CI for a pull request.

USAGE
    gh install <pr-number> [flags]

FLAGS
    --run <run-id>        Use a specific workflow run instead of resolving the PR head
    --download            Download the package only; do not install it
    -h, --help            Show this help

EXAMPLES
    gh install 5135                      # install the package from PR 5135
    gh install 5135 --download           # download the package only (uses the cache)
    gh install --run 123456789           # install from a specific CI run

CACHE
    Packages are cached in ~/.cache/gh-install/packages (or
    \$XDG_CACHE_HOME/gh-install/packages) and reused when the same artifact
    is requested again, verified against its SHA-256 digest.

NOTES
    - Artifacts expire after a retention period; if no artifact is found,
      re-run CI on the PR to produce a fresh one.
    - On Windows, run this from a Git Bash / gh terminal that can elevate
      (msiexec will prompt via UAC if needed).
EOF
}

die() {
    echo "error: $*" >&2
    exit 1
}

info() {
    echo "==> $*"
}

# --------------------------------------------------------------------------
# Parse arguments
# --------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --run)
            RUN_ID="${2:?--run requires a value}"
            shift 2
            ;;
        --download)
            DOWNLOAD_ONLY=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            die "unknown flag: $1 (see --help)"
            ;;
        *)
            [[ -z "$PR" ]] || die "unexpected extra argument: $1"
            PR="$1"
            shift
            ;;
    esac
done

[[ -n "$PR" || -n "$RUN_ID" ]] || { usage; die "a PR number or --run is required"; }

# --------------------------------------------------------------------------
# Preconditions
# --------------------------------------------------------------------------
command -v gh >/dev/null 2>&1 || die "gh (GitHub CLI) is not installed"
gh auth status >/dev/null 2>&1 || die "gh is not authenticated; run 'gh auth login'"

# --------------------------------------------------------------------------
# Detect platform -> artifact pattern
#
# The platform workflows (macos.yml, windows.yml, linux.yml) are only invoked
# via workflow_call from the "Dynamic CI" workflow, so the run to download
# from is always the Dynamic CI run for the PR's head commit.
# --------------------------------------------------------------------------
UNAME="$(uname -s)"
case "$UNAME" in
    Darwin)
        ARTIFACT_REGEX='\.pkg$'
        ;;
    MINGW*|MSYS*|CYGWIN*|Windows_NT)
        ARTIFACT_REGEX='\.(msi|exe)$'
        ;;
    Linux)
        ARTIFACT_REGEX='\.snap$'
        ;;
    *)
        die "unsupported OS: $UNAME"
        ;;
esac

info "Platform: $UNAME"

# --------------------------------------------------------------------------
# Resolve the workflow run
# --------------------------------------------------------------------------
if [[ -z "$RUN_ID" ]]; then
    info "Resolving head commit of PR #$PR in $REPO"
    SHA="$(gh pr view "$PR" --repo "$REPO" --json headRefOid --jq .headRefOid)" \
        || die "could not look up PR #$PR in $REPO"
    info "PR head: $SHA"

    RUN_ID="$(gh run list --repo "$REPO" --commit "$SHA" --workflow "Dynamic CI" \
        --json databaseId,conclusion \
        --jq '[.[] | select(.conclusion == "success")][0].databaseId // empty')"

    [[ -n "$RUN_ID" ]] || die "no successful 'Dynamic CI' run found for $SHA.
       CI may still be running, awaiting approval, or the artifacts may have
       expired. Re-run/approve CI on the PR, or pass --run <id> to use a
       specific run."
fi

info "Using workflow run: $RUN_ID"

# --------------------------------------------------------------------------
# Pick the package artifact
# --------------------------------------------------------------------------
ARTIFACT_NAME="$(gh api "repos/$REPO/actions/runs/$RUN_ID/artifacts" \
    --jq ".artifacts[] | select(.expired == false) | .name" \
    | grep -E "$ARTIFACT_REGEX" | head -n 1 || true)"

[[ -n "$ARTIFACT_NAME" ]] || die "no (unexpired) package artifact matching '$ARTIFACT_REGEX'
       found in run $RUN_ID. Re-run CI on the PR to produce a fresh package."

info "Found artifact: $ARTIFACT_NAME"

# --------------------------------------------------------------------------
# Download (with caching)
# --------------------------------------------------------------------------
mkdir -p "$CACHE_DIR"
PKG_FILE="$CACHE_DIR/$ARTIFACT_NAME"

# sha256 of a file, portable across macOS / Linux / Git Bash.
sha256_of() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        echo ""  # no hasher available -> treat as unverifiable
    fi
}

# The digest of the artifact's zip blob as reported by the API (may be empty).
ARTIFACT_DIGEST="$(gh api "repos/$REPO/actions/runs/$RUN_ID/artifacts" \
    --jq ".artifacts[] | select(.name == \"$ARTIFACT_NAME\" and .expired == false) | .digest // empty" \
    | head -n 1 | sed 's/^sha256://')"

if [[ -f "$PKG_FILE" ]]; then
    if [[ -n "$ARTIFACT_DIGEST" && "$(sha256_of "$PKG_FILE")" != "$ARTIFACT_DIGEST" ]]; then
        info "Cached package failed digest check; re-downloading"
        rm -f "$PKG_FILE"
    else
        info "Using cached package: $PKG_FILE"
    fi
fi

if [[ ! -f "$PKG_FILE" ]]; then
    info "Downloading to cache: $CACHE_DIR"
    gh run download "$RUN_ID" --repo "$REPO" --name "$ARTIFACT_NAME" --dir "$CACHE_DIR"
    [[ -f "$PKG_FILE" ]] || die "download produced no $ARTIFACT_NAME in $CACHE_DIR"
fi

if [[ "$DOWNLOAD_ONLY" -eq 1 ]]; then
    info "Package ready: $PKG_FILE"
    exit 0
fi

# --------------------------------------------------------------------------
# Install
# --------------------------------------------------------------------------
case "$PKG_FILE" in
    *.pkg)
        info "Installing with macOS installer (sudo may prompt for a password)"
        sudo installer -pkg "$PKG_FILE" -target /
        ;;
    *.msi)
        # Convert the Git Bash path to a Windows path for msiexec.
        WIN_PATH="$(cygpath -w "$PKG_FILE" 2>/dev/null || echo "$PKG_FILE")"
        info "Installing $WIN_PATH with msiexec"
        msiexec //i "$WIN_PATH" //passive //norestart
        ;;
    *.exe)
        WIN_PATH="$(cygpath -w "$PKG_FILE" 2>/dev/null || echo "$PKG_FILE")"
        info "Running installer $WIN_PATH"
        "$PKG_FILE"
        ;;
    *.snap)
        info "Installing snap with --dangerous (unsigned CI build)"
        sudo snap install --dangerous "$PKG_FILE"
        ;;
    *)
        die "don't know how to install: $PKG_FILE"
        ;;
esac

info "Done. Multipass from PR #$PR (run $RUN_ID) installed."
